#!/usr/bin/env bash

#
# RECKON - Network and Web Reconnaissance Toolkit
# Executable application launcher
#

# Ensure the application is running under Bash.
if [ -z "${BASH_VERSION:-}" ]; then
    printf 'Error: RECKON requires the Bash shell.\n' >&2
    exit 1
fi

set -o nounset

# Define the minimum supported Bash version.
readonly MIN_BASH_MAJOR=4
readonly MIN_BASH_MINOR=4

# Validate the running Bash version.
if (( BASH_VERSINFO[0] < MIN_BASH_MAJOR ||
      (BASH_VERSINFO[0] == MIN_BASH_MAJOR &&
       BASH_VERSINFO[1] < MIN_BASH_MINOR) )); then

    printf 'Error: RECKON requires Bash %s.%s or newer.\n' \
        "$MIN_BASH_MAJOR" "$MIN_BASH_MINOR" >&2

    printf 'Detected Bash version: %s\n' "$BASH_VERSION" >&2
    exit 1
fi

# Resolve the absolute project directory.
if ! PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"; then
    printf 'Error: Unable to determine the project directory.\n' >&2
    exit 1
fi

readonly PROJECT_ROOT

# Locate application components.
readonly METADATA_FILE="$PROJECT_ROOT/core/metadata.sh"
readonly MAIN_FILE="$PROJECT_ROOT/core/main.sh"

# Validate required application files.
for required_file in "$METADATA_FILE" "$MAIN_FILE"; do
    if [[ ! -f "$required_file" || ! -r "$required_file" ]]; then
        printf 'Error: Required application file is missing or unreadable: %s\n' \
            "$required_file" >&2
        exit 1
    fi
done

# Load application metadata.
# shellcheck source=core/metadata.sh
if ! source "$METADATA_FILE"; then
    printf 'Error: Failed to load application metadata.\n' >&2
    exit 1
fi

# Load the main application component.
# shellcheck source=core/main.sh
if ! source "$MAIN_FILE"; then
    printf 'Error: Failed to load the main application component.\n' >&2
    exit 1
fi